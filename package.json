{
  "name": "weft",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "upstream:prepare": "node scripts/prepare-upstream.mjs",
    "build": "npm run upstream:prepare && node scripts/build.mjs",
    "typecheck": "npm run build && tsc --noEmit",
    "test:unit": "tsx --test --test-concurrency=1 --test-timeout=300000 tests/*.test.ts",
    "test": "npm run build && npm run test:unit",
    "dev": "npm run build && node scripts/dev.mjs",
    "deploy:workers": "cf deploy --prebuilt --worker weft-ui-assets && cf deploy --prebuilt",
    "deploy": "npm run build && npm run deploy:workers",
    "deploy:check": "npm run build && cf deploy --prebuilt --worker weft-ui-assets --dry-run && cf deploy --prebuilt --dry-run",
    "check": "npm run typecheck && npm run test:unit",
    "test:live": "node scripts/verify-live-model.mjs",
    "test:live:workspace": "node scripts/verify-live-workspace.mjs",
    "test:web": "npm run build && playwright test",
    "test:web:live": "npm run build && WEFT_BROWSER_LIVE=1 playwright test --grep 'real DeepSeek'"
  },
  "dependencies": {
    "@cloudflare/computer": "0.5.1",
    "@shikijs/langs": "4.4.3",
    "@standard-schema/spec": "1.1.0",
    "acorn": "8.15.0",
    "anser": "2.3.5",
    "chokidar": "5.0.0",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "eventsource-parser": "3.1.0",
    "immer": "10.1.1",
    "katex": "0.18.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.4.3",
    "simple-icons": "16.31.0",
    "sucrase": "3.35.0",
    "use-sync-external-store": "1.6.0",
    "yaml": "2.9.1",
    "zod": "4.4.3",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.2",
    "@cloudflare/config": "0.26.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "1.58.2",
    "@types/katex": "0.16.7",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/use-sync-external-store": "1.5.0",
    "cf": "1.0.0-beta.17",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "4.151.1"
  }
}
