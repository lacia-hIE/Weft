{
  "name": "weft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "upstream:prepare": "node scripts/prepare-upstream.mjs",
    "build": "npm run upstream:prepare && node scripts/generate-official-remotes.mjs && node scripts/build-official-ui.mjs && node scripts/prepare-official-boot.mjs && node scripts/build.mjs",
    "typecheck": "npm run build && tsc --noEmit",
    "test:unit": "tsx --test --test-concurrency=1 --test-timeout=300000 tests/*.test.ts",
    "test": "npm run build && npm run test:unit",
    "dev": "npm run build && node scripts/dev.mjs",
    "deploy:workers": "node scripts/deploy-workers.mjs",
    "deploy": "npm run build && npm run deploy:workers",
    "deploy:check": "npm run build && npm run deploy:workers -- --dry-run",
    "check": "npm run typecheck && npm run test:unit",
    "test:images:remote": "npm run build && node scripts/verify-native-images.mjs",
    "test:live": "node scripts/verify-live-model.mjs",
    "test:live:workspace": "node scripts/verify-live-workspace.mjs",
    "test:process:container": "WEFT_PROCESS_TESTS=1 tsx --test tests/process-container.test.ts",
    "test:workspace:container": "WEFT_CONTAINER_TESTS=1 tsx --test tests/workspace-container.test.ts",
    "test:web": "npm run build && playwright test",
    "test:web:live": "npm run build && WEFT_BROWSER_LIVE=1 playwright test --grep 'real DeepSeek'",
    "test:web:queue": "npm run build && WEFT_BROWSER_QUEUE=1 playwright test tests/browser/queue.spec.ts",
    "test:web:plugins": "npm run build && WEFT_BROWSER_PLUGINS=1 playwright test tests/browser/native-plugins.spec.ts",
    "test:web:subagents": "npm run build && WEFT_BROWSER_SUBAGENTS=1 playwright test tests/browser/subagents.spec.ts",
    "upstream:remotes": "npm run upstream:prepare && node scripts/generate-official-remotes.mjs",
    "build:official-ui": "npm run upstream:remotes && node scripts/build-official-ui.mjs && node scripts/prepare-official-boot.mjs"
  },
  "dependencies": {
    "@cloudflare/computer": "0.7.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@fortune-sheet/core": "1.0.4",
