{
  "name": "@laciaproject/dsh-local-host",
  "version": "0.2.7",
  "description": "Connect a local DSH Host to your Weft environment",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./dsh.bundle.patch.yml": "./dsh.bundle.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "transport.mjs",
    "controller.mjs",
    "mux.mjs",
    "mux.d.mts",
    "client.js",
    "compatibility.mjs",
    "compatibility.d.mts",
    "dsh.bundle.patch.yml",
    "README.md",
    "locale/en.json",
    "locale/zh.json"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacia-hIE/Weft.git",
    "directory": "packages/local-host-connector"
  },
  "homepage": "https://github.com/lacia-hIE/Weft/tree/main/packages/local-host-connector",
  "bugs": {
    "url": "https://github.com/lacia-hIE/Weft/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
